# ─────────────────────────────────────────────────────────────────────────────
# UNITÉ SYSTEMD — à poser dans /etc/systemd/system/droplink.service
#
# ⚠️ CE FICHIER N'A PAS ÉTÉ EXÉCUTÉ. Il est écrit depuis une machine Windows,
# où systemd n'existe pas : contrairement au `crontab.txt` voisin, dont le
# contrat a été MESURÉ contre un serveur réel, celui-ci n'est vérifié par rien.
# Le dire est le minimum — un fichier de configuration qui a l'air correct et
# que personne n'a lancé est exactement ce que L-014 décrit.
#
# ⚠️ ET LE PIÈGE WINDOWS DEVIENT UN PIÈGE LINUX. Sur ce projet, `child.kill()`
# ne tuait que `pnpm` et laissait le vrai serveur en écoute : les démarrages
# suivants échouaient EN SILENCE et les requêtes atteignaient un build
# antérieur. `KillMode=control-group` ci-dessous ferme l'ARBRE, pas seulement
# le processus lancé — c'est la même leçon, transposée.
#
# CE QU'IL RESTE À FAIRE AUTOUR, et qu'aucun fichier ne peut faire à ta place :
#   - un reverse proxy en HTTPS devant (Caddy obtient un certificat tout seul) ;
#     ce n'est PAS optionnel : l'URL de `/p/{jeton}` PORTE la capacité, et une
#     seule interception en clair transfère un accès définitif aux photos ;
#   - `NEXT_PUBLIC_SITE_URL` doit valoir le domaine public, pas localhost :
#     c'est lui qui construit les liens envoyés par email ;
#   - une IP fixe ou un DNS dynamique. Si l'adresse de la box change, TOUS les
#     liens déjà envoyés aux clients tombent — et le jeton étant immuable à
#     vie, on ne peut pas les réémettre.
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=DropLink — serveur Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=droplink
WorkingDirectory=/opt/droplink
EnvironmentFile=/opt/droplink/.env.local

# `next start` directement, sans pnpm : un intermédiaire de plus est un
# processus de plus à tuer, et c'est précisément ce qui a déjà piégé ce projet.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000

Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

# Le service n'a besoin d'écrire nulle part sauf dans son cache de build.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/droplink/.next

[Install]
WantedBy=multi-user.target
