# ═══════════════════════════════════════════════════════════════════════════
# CE FICHIER DECRIT `.env.local` — LA PRODUCTION.
#
# ⚠️ IL EXISTE UN SECOND FICHIER, `.env.test.local`, ET LES PORTES NE PARTENT
# PAS SANS LUI. Depuis le 06/09/2026 les suites visent un projet Supabase
# SEPARE (`droplink-tests`) : elles ecrivaient jusque-la dans la base des vrais
# clients, et l une d elles y a efface de vrais colis le 05/09.
#
# `scripts/portes.mjs` REFUSE de demarrer si `.env.test.local` manque. Pour le
# reconstruire, il faut cinq lignes :
#
#   SUPABASE_PROJET_TESTS=<ref du projet de tests>
#   NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<cle publishable du projet de tests>
#   SUPABASE_SERVICE_ROLE_KEY=<cle service_role du projet de tests>
#   SUPABASE_DB_URL=postgresql://postgres.<ref>:<mdp>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# ET LA BASE DOIT SE DECLARER ELLE-MEME, sinon le harnais refuse aussi :
#
#   comment on database postgres is '... BASE DE TESTS ...';
#
# Un projet neuf se prepare avec `pnpm db:migrate` (SUPABASE_DB_URL pointee sur
# lui), puis `mailer_autoconfirm=true` et `password_min_length=12` cote Supabase
# pour coller a la production. ⚠️ La 093 echoue sur une base VIERGE : elle
# supprime une surcharge que seul le falsificateur avait creee en production —
# la recreer avant, voir le message du commit qui a cree la base de tests.
# ═══════════════════════════════════════════════════════════════════════════

# --- Supabase ---------------------------------------------------------------
# Seule la cle publiable porte le prefixe NEXT_PUBLIC : elle est destinee au
# navigateur. La cle service-role ne doit JAMAIS le porter (principe VI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Jeton personnel, UNIQUEMENT pour `pnpm db:types` en local. Jamais en prod.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# --- Cloudflare R2 ----------------------------------------------------------
# Aucune variable R2 ne porte NEXT_PUBLIC : une seule fuite donnerait acces aux
# medias de tous les vendeurs. Token en Object Read & Write, limite au bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sel des empreintes -----------------------------------------------------
# Sans sel, une IPv4 hachee se retrouve en quelques secondes (link_views).
HASH_SALT=

# --- Services tiers (lots ulterieurs) ---------------------------------------
RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
# Cle du fournisseur de suivi (17TRACK). Elle sert a DEUX choses qui n en font
# qu une du point de vue de la securite : prendre en charge des numeros a nos
# frais, et VERIFIER LA SIGNATURE des notifications entrantes. Une fuite
# donnerait donc a qui la trouve le droit d ecrire dans les commandes de
# n importe quel vendeur, en signant de fausses notifications.
#
# JAMAIS prefixee NEXT_PUBLIC_. Tant qu elle est vide, le point de reception
# REFUSE tout (503) plutot que d accepter : une verification sans cle
# accepterait ou refuserait tout, et accepter tout est la pire des deux options.
TRACKING_API_KEY=

# Adresse de signalement de contenu. Tant qu elle est vide, la page de
# signalement rend 404 et le lien du pied de page disparait : une procedure
# sans destinataire n en est pas une.
NEXT_PUBLIC_CONTACT_ABUS=

# Secret du declencheur de la tache de fond du suivi. Au moins 16 caracteres.
# Ce qu il protege COUTE DE L ARGENT : chaque passage interroge le fournisseur,
# et une route de tache de fond laissee ouverte est un robinet que n importe qui
# peut ouvrir a nos frais. Tant qu il est vide ou trop court, la route REFUSE —
# elle ne passe pas en mode ouvert pour le developpement.
CRON_SECRET=

# --- Connexion Google -------------------------------------------------------
# DEUX COTES, ET IL FAUT LES DEUX. Cette variable ne fait qu une chose : decider
# si le bouton « Continuer avec Google » est RENDU. Elle ne configure rien.
# L activation reelle vit dans le tableau de bord Supabase (Authentication ->
# Sign In / Providers -> Google), avec l identifiant client obtenu chez Google.
#
# ⚠️ L ORDRE COMPTE, et le mettre a l envers se voit par tous les visiteurs.
# Mesure le 06/09/2026 sur le vrai projet, Google non active chez Supabase :
#   GET /auth/v1/authorize?provider=google
#   400 {"msg":"Unsupported provider: provider is not enabled"}
# Poser cette variable AVANT d avoir configure Supabase affiche donc un bouton
# qui mene a du JSON brut, sur un domaine `supabase.co` dont le visiteur n a
# jamais entendu parler. Configurer Supabase D ABORD, poser ceci EN DERNIER —
# et `pnpm check:google` verifie que les deux disent la meme chose.
#
# Valeur EXACTE attendue : 1. Vide, absente ou autre chose = bouton non rendu,
# et l action refuse aussi : ne pas afficher un bouton n empeche personne
# d appeler la Server Action qui est derriere.
AUTH_GOOGLE_ACTIF=

# --- Le bord, et ce qu on croit de lui --------------------------------------
# ORIGINE CANONIQUE DU SITE. OBLIGATOIRE EN PRODUCTION : sans elle, la demande
# de reinitialisation de mot de passe ECHOUE et le dit. L URL de retour porte le
# pouvoir d ouvrir un compte — une requete forgee avec `Host: exemple-mal.tld`
# produirait un email envoye a la VRAIE adresse de la victime, dont le lien mene
# chez l attaquant. Cette ligne disait « la demande de lien magique » : ce
# mecanisme est SUPPRIME depuis le 01/09/2026, mais la menace a seulement change
# de porteur — l email qui ouvre encore un compte est celui du recours.
# En developpement, laisser vide : l en-tete sert alors de repli.
NEXT_PUBLIC_SITE_URL=

# A QUEL EN-TETE ON FAIT CONFIANCE POUR L ADRESSE DE L APPELANT.
#   cloudflare (defaut) — seul `cf-connecting-ip`, que Cloudflare REECRIT a
#                         chaque requete, donc infalsifiable de l exterieur.
#   xff                 — premiere entree de `x-forwarded-for`. A ne poser que
#                         derriere un bord qui la reecrit lui aussi.
#   aucun               — aucune adresse deduite d un en-tete.
# `x-forwarded-for` etait cru SANS CONDITION : c est une liste que le client peut
# preremplir, donc toute la limitation publique se contournait en changeant un
# en-tete. Toute valeur illisible retombe sur `cloudflare`.
BORD_DE_CONFIANCE=cloudflare

# --- Alertes vers l exploitant ----------------------------------------------
# Webhook Discord des alertes (budget de suivi, paiement non rattache). Vide :
# les alertes ne partent pas, seul un log le dit. C est un SECRET : quiconque le
# connait peut ecrire dans le salon.
DISCORD_WEBHOOK_URL=
# Alertes de veille par e-mail (Resend). Vides : pas d e-mail d alerte.
EMAIL_ALERTES_A=
EMAIL_ALERTES_DE=

# --- E-mails de suivi au client final (migrations 188-192) -------------------
# Expediteur des e-mails de suivi, sur un domaine VERIFIE chez Resend, ex.
# `DropLink <suivi@droplink.fr>`. Vide : la carte « Suivi par e-mail » n est
# pas affichee sur la page client et rien ne part — c est voulu.
EMAIL_CLIENTS_DE=

# --- Abonnement Pro (Lemon Squeezy, Merchant of Record) ---------------------
# Lien de paiement du produit Pro (https, hote lemonsqueezy.com). Vide : l ecran
# « Passer au Pro » s affiche SANS bouton. Le produit y ajoute lui-meme
# l identifiant du compte (`checkout[custom][profil_id]`).
LEMON_SQUEEZY_CHECKOUT_URL=
# Secret de signature du webhook `/api/paiement/lemon-squeezy`. Vide : le
# webhook repond 503 a tout — jamais « accepte sans verifier ».
LEMON_SQUEEZY_WEBHOOK_SECRET=
